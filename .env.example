# ─────────────────────────────────────────────────────────────
# Thinkcontrol · variáveis de ambiente
# Copie este arquivo como .env.local e preencha os valores.
# Nunca commite .env.local.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ───────────────────────────
# Pooled connection (usada em runtime pelo app)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (usada por prisma migrate)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (client) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# ── Supabase (server) ──────────────────────────────────────
# Chave admin para criar/gerenciar usuários via server actions.
# Só server-side, NUNCA expor.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# URL pública usada no link enviado aos novos usuários.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Google Drive integrado (server-side) ───────────────────
# Crie um cliente OAuth do tipo "Aplicativo da Web" no Google Cloud.
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/integrations/google/drive/callback
GOOGLE_DRIVE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_DRIVE_CLIENT_SECRET="<google-oauth-client-secret>"
# Gere uma chave de 32 bytes: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY="<base64-32-byte-key>"
# Pasta raiz da operação no Google Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID="10X4Wp_hPFnG57F5EhH8hEETBEVGHRN26"

# Senhas iniciais por perfil. Não commitar valores reais.
ADMIN_INITIAL_PASSWORD="<senha-inicial-do-admin>"
MANAGER_INITIAL_PASSWORD="<senha-inicial-da-gestao>"
MEMBER_INITIAL_PASSWORD="<senha-inicial-do-colaborador>"
CLIENT_INITIAL_PASSWORD="<senha-inicial-do-cliente>"
